# Copy to .env and fill in. Never commit .env.

# NASA Earthdata login (EMIT V002 via earthaccess): https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# NASA FIRMS MAP_KEY (VIIRS active fire, flare mask): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Hugging Face access token (write scope for model and Space upload): https://huggingface.co/settings/tokens
HF_TOKEN=

# Google Earth Engine cloud project ID (Sentinel-2 L1C): https://code.earthengine.google.com/register
GEE_PROJECT=

# Carbon Mapper API token (optional; non-commercial licence, never commit downloads): https://data.carbonmapper.org (Account > Create API Token)
CARBONMAPPER_API_TOKEN=
